# Local mode is the default; it uses gh auth login, GH_TOKEN, or GITHUB_TOKEN.
AUTH_MODE=local

# GitHub App mode: set AUTH_MODE=github-app and fill in these values.
PUBLIC_URL=http://localhost:3000
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Optional: adds a link for users to install the app on their repositories.
GITHUB_APP_SLUG=

# Bind address for GitHub App mode.
# Local mode always binds to 127.0.0.1.
HOST=127.0.0.1
PORT=3000
