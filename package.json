{
  "name": "gh-pull",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A fast, local GitHub pull request dashboard",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --watch server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "test:browser": "node --test scripts/*browser-check.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "cli": "node cli/main.js",
    "build:extension": "node scripts/build-extension.mjs",
    "test:extension": "node --test scripts/extension-check.mjs",
    "test:extension:browser": "node --test scripts/extension-ui-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@svgdotjs/svg.js": "3.2.8",
    "esbuild": "0.28.2",
    "lit-html": "^3.3.3",
    "playwright": "1.64.0",
    "postject": "1.0.0-alpha.6",
    "proper-lockfile": "4.1.2"
  }
}
